{
  "name": "my-music",
  "private": true,
  "description": "A personal music player web app. No build step; these packages are only for code checks.",
  "type": "module",
  "scripts": {
    "lint": "npm run lint:js && npm run lint:types && npm run lint:css && npm run lint:html && npm run lint:md",
    "lint:js": "eslint .",
    "lint:types": "tsc -p jsconfig.json",
    "lint:css": "stylelint styles.css",
    "lint:html": "html-validate index.html",
    "lint:md": "markdownlint-cli2 README.md PLAN.md"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "html-validate": "^9.7.1",
    "markdownlint-cli2": "^0.17.2",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^36.0.1",
    "typescript": "^5.9.3"
  }
}
